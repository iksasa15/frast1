[Unit]
Description=RootIQ Collector
After=network-online.target
[Service]
EnvironmentFile=/etc/rootiq/collector.env
WorkingDirectory=/opt/rootiq/lab/collector
ExecStart=/opt/rootiq/collector-venv/bin/python /opt/rootiq/lab/collector/collector.py
Restart=always
RestartSec=2
[Install]
WantedBy=multi-user.target
