ROOTIQ_BACKEND=http://BACKEND_IP:8000
ROOTIQ_INGEST_TOKEN=USE_THE_SAME_LONG_RANDOM_TOKEN_AS_THE_BACKEND
ROOTIQ_SITE=eve-ng-lab
ROOTIQ_COLLECTOR_ID=COLLECTOR-01

# At least one reachable network-device management IP. Add more as a safety net.
ROOTIQ_SEEDS=10.10.20.1,10.10.20.2
ROOTIQ_DEVICE_USERNAME=rootiq
ROOTIQ_DEVICE_PASSWORD=REPLACE_ME
ROOTIQ_DEVICE_TYPE=cisco_ios
ROOTIQ_DEVICE_PORT=22

ROOTIQ_DISCOVERY_INTERVAL=60
ROOTIQ_POLL_INTERVAL=5

# Optional JSON array of real monitored services. Hosts must match discovered node IDs.
# ROOTIQ_SERVICES_FILE=/etc/rootiq/services.json
