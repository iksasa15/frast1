        "enter": [],
        "save": [
          "nv config apply",
          "nv config save"
        ],
        "snapshot": [],
        "safe_change": [
          "nv config apply --confirm 5m"
        ],
        "rollback": [
          "nv config history"
        ],
        "notes": "`nv config diff` shows the pending changes. Applies to Cumulus Linux 5.x with NVUE (the older ifupdown2/NCLU flow differs)."
