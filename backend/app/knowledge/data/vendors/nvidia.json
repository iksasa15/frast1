  "commands": {
    "default": {
      "show_version": {
        "read": [
          "nv show system"
        ]
      },
      "show_interface_status": {
        "read": [
          "nv show interface"
        ]
      },
      "show_interface_detail": {
        "read": [
          "ip -s link show <if>"
        ]
      },
      "show_interface_errors": {
        "read": [
          "ethtool -S <if>",
          "ip -s link show <if>"
        ]
      },
      "show_optics": {
        "read": [
          "ethtool -m <if>"
        ]
      },
      "show_vlan": {
        "read": [
          "bridge vlan show"
        ]
      },
      "show_mac_table": {
        "read": [
          "bridge fdb show"
        ]
      },
      "show_neighbors": {
        "read": [
          "lldpctl"
        ]
      },
      "show_cpu": {
        "read": [
          "top -bn1 | head -20"
        ]
      },
      "show_memory": {
        "read": [
          "free -m"
        ]
      },
      "show_logging": {
        "read": [
          "journalctl -n 200"
        ]
      },
      "show_arp": {
        "read": [
          "ip neigh show"
        ]
      },
      "show_ospf": {
        "read": [
          "vtysh -c 'show ip ospf neighbor'"
        ]
      },
      "show_bgp": {
        "read": [
          "vtysh -c 'show bgp summary'"
        ]
      },
      "show_lag": {
        "read": [
          "cat /proc/net/bonding/bond0"
        ]
      },
      "bounce_interface": {
        "change": [
          "sudo ip link set <if> down",
          "sudo ip link set <if> up"
        ]
      }
    }
  },
