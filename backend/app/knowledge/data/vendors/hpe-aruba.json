  "syslog": [
    {
      "id": "port-online",
      "regex": "\\bports?:?\\s+port\\s+(?P<interface>[A-Za-z]?\\d+(?:/\\d+)*)\\s+is now\\s+(?P<state>on-line|off-line)",
      "state_map": {
        "on-line": "up",
        "off-line": "down"
      },
      "event": "interface_state",
      "severity": "warning",
      "example": "I 09/29/26 10:02:11 00077 ports: port 1 is now off-line"
    }
