  "os_families": [
    {
      "id": "aos-cx",
      "name": "ArubaOS-CX",
      "cli": "aoscx",
      "netmiko": "aruba_aoscx",
      "aliases": [
        "aos-cx",
        "aoscx",
        "arubaos-cx"
      ],
      "sysdescr_regex": [
        "Aruba (?P<sku>[A-Z]{1,2}\\d{3,5}[A-Z]?) (?P<model>.+?)\\s+Swch\\s+(?P<version>[A-Z]{2}\\.\\d{2}\\.\\d{2}\\.\\d{3,4})"
      ],
      "version_regex": "(?P<version>[A-Z]{2}\\.\\d{2}\\.\\d{2}\\.\\d{3,4})",
      "version_scheme": "PP.MM.BBBB with a 2-letter platform prefix, e.g. FL.10.09.1020 (10.09 = release, 1020 = build).",
      "examples": {
        "sysdescr": [
          "Aruba JL659A 6300M 48SR5 CL6 PoE 4SFP56 Swch FL.10.09.1020"
        ],
        "version": [
          "FL.10.09.1020"
        ]
      },
      "config_model": {
        "style": "running-startup",
        "summary": "Changes take effect immediately in the running configuration. They are lost at reload unless they are copied to the startup configuration (NVRAM).",
        "summary_ar": "التغييرات تسري فورًا على الإعداد الجاري (running) وتضيع عند إعادة التشغيل ما لم تُنسخ إلى إعداد الإقلاع (startup / NVRAM).",
        "enter": [
          "configure terminal"
        ],
        "save": [
          "write memory",
          "copy running-config startup-config"
        ],
        "snapshot": [
          "checkpoint <name>"
        ],
        "safe_change": [],
        "rollback": [
          "checkpoint rollback <name>"
        ],
        "notes": "Checkpoints are the rollback mechanism; verify the exact checkpoint syntax on your AOS-CX release."
      },
      "cli_style": "Cisco-like CLI. Interfaces are member/slot/port (`1/1/1`). `show running-config`, checkpoints for rollback, REST API and NAE built in. Enable a port with `no shutdown`.",
      "cli_style_ar": "واجهة شبيهة بـCisco. أسماء الواجهات member/slot/port (`1/1/1`). `show running-config` ونقاط استرجاع (checkpoints) وREST API وNAE مدمج. فعّل المنفذ بـ`no shutdown`."
    },
    {
      "id": "arubaos-switch",
      "name": "ArubaOS-Switch (ProVision / ProCurve)",
      "cli": "provision",
      "netmiko": "aruba_osswitch",
      "aliases": [
        "arubaos-switch",
        "provision",
        "procurve",
        "hp procurve"
      ],
      "sysdescr_regex": [
        "(?:ProCurve|Aruba|HP)\\s+(?P<sku>[JL][A-Z]?\\d{3,5}[A-Z]?)\\s+(?P<model>[^,]+?)\\s+Switch,\\s+revision\\s+(?P<version>[A-Z]{1,2}\\.\\d+\\.\\d+\\.\\d+)"
      ],
      "version_regex": "revision\\s+(?P<version>[A-Z]{1,2}\\.\\d+\\.\\d+\\.\\d+)",
      "version_scheme": "PP.MM.mm.bbbb with a 1-2 letter platform prefix, e.g. YA.16.10.0003 (YA = 2530, WC = 2930F/M, KB = 5400R).",
      "examples": {
        "sysdescr": [
          "ProCurve J9773A 2530-24G-PoEP Switch, revision YA.16.04.0008, ROM YA.15.10 (/sw/code/build/xxx)"
        ],
        "version": [
          "YA.16.10.0003",
          "WC.16.11.0004"
        ]
      },
      "config_model": {
        "style": "running-startup",
        "summary": "Changes take effect immediately in the running configuration. They are lost at reload unless they are copied to the startup configuration (NVRAM).",
        "summary_ar": "التغييرات تسري فورًا على الإعداد الجاري (running) وتضيع عند إعادة التشغيل ما لم تُنسخ إلى إعداد الإقلاع (startup / NVRAM).",
        "enter": [
          "configure"
        ],
        "save": [
          "write memory"
        ],
        "snapshot": [],
        "safe_change": [],
        "rollback": [],
        "notes": "No automatic rollback: to undo an unsaved change, reload without saving."
      },
      "cli_style": "HP ProCurve heritage: `show interfaces brief`, ports named like `A1` or `1`, `disable` / `enable` instead of shutdown / no shutdown, `write memory` to persist; a menu interface also exists.",
      "cli_style_ar": "إرث HP ProCurve: `show interfaces brief` والمنافذ باسم مثل `A1` أو `1`، و`disable` / `enable` بدل shutdown / no shutdown، و`write memory` للحفظ؛ وتوجد أيضًا واجهة قوائم."
    }
  ],
