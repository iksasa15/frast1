  "coverage": "full",
  "confidence": "high",
  "os_families": [
    {
      "id": "eos",
      "name": "Arista EOS",
      "cli": "ios",
      "netmiko": "arista_eos",
      "aliases": [
        "eos",
        "arista eos"
      ],
      "sysdescr_regex": [
        "Arista Networks EOS version (?P<version>\\d+\\.\\d+\\.\\d+[A-Za-z]*)(?: running on an Arista Networks (?P<model>\\S+))?"
      ],
      "version_regex": "Software image version:\\s*(?P<version>\\d+\\.\\d+\\.\\d+[A-Za-z]*)",
      "version_scheme": "MAJOR.MINOR.PATCH + suffix, e.g. 4.30.5M (M = maintenance/long-term train, F = feature release).",
      "examples": {
        "sysdescr": [
          "Arista Networks EOS version 4.30.5M running on an Arista Networks DCS-7050SX3-48YC8",
          "Arista Networks EOS version 4.30.5M running on an Arista Networks vEOS-lab"
        ],
        "version": [
          "4.30.5M",
          "4.32.1F"
        ]
      },
      "config_model": {
        "style": "running-startup",
        "summary": "Changes take effect immediately in the running configuration. They are lost at reload unless they are copied to the startup configuration (NVRAM).",
        "summary_ar": "التغييرات تسري فورًا على الإعداد الجاري (running) وتضيع عند إعادة التشغيل ما لم تُنسخ إلى إعداد الإقلاع (startup / NVRAM).",
        "enter": [
          "configure terminal"
        ],
        "save": [
          "write memory",
          "copy running-config startup-config"
        ],
        "snapshot": [
          "copy running-config flash:<backup>"
        ],
        "safe_change": [
          "configure session <name>",
          "commit timer 00:05:00"
        ],
        "rollback": [
          "configure replace flash:<backup>"
        ],
        "notes": "Optional config sessions: `configure session <name>`, `show session-config diffs`, then `commit timer 00:05:00` (auto-revert unless confirmed) or `abort`."
      },
      "cli_style": "Cisco-like modal CLI. `show ... | json` returns JSON; `| grep` and `| include` filter. Optional config sessions add diff and timed commit. Interfaces: `Ethernet1`, `Ethernet1/1`, `Port-Channel1`, `Management1`.",
      "cli_style_ar": "واجهة شبيهة بـCisco متعددة الأوضاع. `show ... | json` يعيد JSON، و`| grep` و`| include` للفلترة. جلسات الإعداد الاختيارية تضيف المقارنة والالتزام المؤقت. الواجهات: `Ethernet1` و`Ethernet1/1` و`Port-Channel1` و`Management1`."
    }
  ],
