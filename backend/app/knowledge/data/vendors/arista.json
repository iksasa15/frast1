  "syslog": [
    {
      "id": "lineproto",
      "regex": "%LINEPROTO-\\d-UPDOWN:\\s*Line protocol on Interface\\s+(?P<interface>\\S+), changed state to\\s+(?P<state>up|down)",
      "event": "interface_state",
      "severity": "warning",
      "example": "%LINEPROTO-5-UPDOWN: Line protocol on Interface Ethernet1, changed state to down"
    },
    {
      "id": "stp-state",
      "regex": "%SPANTREE-\\d-INTERFACE_STATE:\\s*Interface\\s+(?P<interface>\\S+) instance \\S+ moved from (?P<from_state>\\w+) to (?P<to_state>\\w+)",
      "event": "stp_port_state",
      "severity": "info",
      "example": "%SPANTREE-6-INTERFACE_STATE: Interface Ethernet1 instance MST0 moved from forwarding to blocking"
    },
    {
      "id": "config-i",
      "regex": "%SYS-5-CONFIG_I:\\s*Configured from\\s+(?P<source>\\S+)\\s+by\\s+(?P<user>\\S+)",
      "event": "config_change",
      "severity": "info",
      "example": "%SYS-5-CONFIG_I: Configured from console by admin on vty0 (10.0.0.5)"
    }
