      "sysdescr_regex": [
        "FortiSwitch-(?P<model>[0-9A-Za-z\\-]+)"
      ],
      "version_regex": "Version:\\s*FortiSwitch-\\S+\\s+v(?P<version>\\d+\\.\\d+\\.\\d+)",
      "version_scheme": "MAJOR.MINOR.PATCH, e.g. 7.2.5 (managed standalone or by FortiGate FortiLink).",
      "examples": {
        "sysdescr": [
          "FortiSwitch-124E-POE"
        ],
        "version": [
          "7.2.5"
        ]
      },
      "config_model": {
        "style": "auto-save",
        "summary": "Each `end` / `next` applies the change immediately and persists it: there is no separate save step, so take a backup before a risky change.",
        "summary_ar": "كل `end` / `next` يطبّق التغيير فورًا ويحفظه: لا توجد خطوة حفظ منفصلة، لذلك خذ نسخة احتياطية قبل أي تغيير محفوف بالمخاطر.",
        "enter": [
          "config <path>"
        ],
        "save": [],
        "snapshot": [
          "execute backup config tftp <file> <server>"
        ],
        "safe_change": [],
        "rollback": [
          "execute restore config tftp <file> <server>"
        ],
        "notes": "A FortiSwitch managed through FortiLink is configured from the FortiGate; the switch CLI then shows the result but the FortiGate owns the configuration."
      },
      "cli_style": "Same FortiOS-style CLI (`config` / `edit` / `set` / `next` / `end`) with switch-specific trees: `diagnose switch ...`, `get switch ...`, `config switch physical-port`. Ports are `port1`..`portN`.",
      "cli_style_ar": "نفس أسلوب FortiOS (`config` / `edit` / `set` / `next` / `end`) مع أشجار خاصة بالسوتش: `diagnose switch ...` و`get switch ...` و`config switch physical-port`. المنافذ `port1` إلى `portN`."
    },
    {
      "id": "fortios",
      "name": "FortiOS (FortiGate firewalls)",
      "cli": "fortios",
      "netmiko": "fortinet",
      "aliases": [
        "fortios",
