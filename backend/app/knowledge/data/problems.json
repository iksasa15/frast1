      ],
      "verify": [
        {
          "metric": "link_packet_loss",
          "op": "<",
          "value": 1
        }
      ],
      "rootiq_kind": null,
      "vendor_hints": {
        "cisco": "%CDP-4-DUPLEX_MISMATCH in the log names the port and the peer."
      },
      "applies_to": [
        "link"
      ]
    },
