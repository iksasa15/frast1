          "link_latency_ms"
        ],
        "events": [
          "duplex_mismatch"
        ]
      },
      "causes": [
        "One end hard-coded and the other on auto",
        "Autonegotiation failure on an old NIC or cable",
        "Misconfigured speed on one side"
