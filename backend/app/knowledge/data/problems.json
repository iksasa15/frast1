      "severity": "high",
      "title": "CRC / input errors on a port",
      "title_ar": "أخطاء CRC / أخطاء إدخال على المنفذ",
      "summary": "Frames arrive corrupted (FCS/CRC errors), causing retransmissions and hidden packet loss even though the link is 'up'.",
      "summary_ar": "تصل الإطارات تالفة (CRC/FCS) فتحدث إعادة إرسال وفقد خفي رغم أن الرابط يبدو UP.",
      "keywords": [
        "crc",
        "fcs",
        "input errors",
        "corrupt",
        "runts",
        "giants",
        "أخطاء",
        "تالف"
      ],
      "signals": {
        "metrics": [
          "link_packet_loss"
        ],
        "events": [
          "crc_errors"
        ]
      },
      "causes": [
        "Bad or damaged cable / connector",
        "Dirty or bent fiber, faulty SFP/transceiver",
        "Duplex/speed mismatch",
        "Electromagnetic interference"
      ],
      "checks": [
