{
  "version": 1,
  "problems": [
    {
      "id": "link-congestion",
      "category": "performance",
      "severity": "high",
      "title": "Link congestion / bandwidth saturation",
      "title_ar": "ازدحام الرابط / تشبّع السعة",
      "summary": "Utilization stays near line rate; queues overflow, latency and packet loss rise for everything sharing the link.",
      "summary_ar": "يقترب استخدام الرابط من سعته فتمتلئ الطوابير ويرتفع التأخير وفقد الحزم لكل ما يمر عبره.",
      "keywords": [
        "congestion",
        "saturat",
        "bandwidth",
        "utilization",
        "queue drops",
        "slow",
        "ازدحام",
        "تشبع",
        "بطء",
        "سعة"
      ],
      "signals": {
        "metrics": [
          "link_utilization",
          "link_latency_ms",
          "link_packet_loss",
          "if_out_discards_rate"
        ],
        "events": [
          "qos_drops"
        ]
      },
      "causes": [
        "Bulk backup/replication or test traffic on a shaped uplink",
        "No QoS classification, so critical flows share the queue with bulk",
        "Uplink too small for the offered load",
        "A loop or storm inflating traffic"
      ],
      "checks": [
        {
          "capability": "show_interface_detail",
          "why": "Confirm utilization, output drops and rate on the suspected port"
        },
        {
          "capability": "show_qos",
          "why": "Read queue / policer counters per class"
        },
        {
          "capability": "show_interface_errors",
          "why": "Rule out physical errors that look like loss"
        },
        {
          "capability": "show_logging",
          "why": "Look for STP or flap events at the same time"
        }
      ],
      "fixes": [
        {
          "id": "apply-qos",
          "title": "Police or queue bulk traffic (QoS policy on the congested egress)",
          "risk": "low",
          "needs_approval": true,
          "rollback": "Remove the policy / restore the previous one",
          "change_capabilities": []
        },
        {
          "id": "reroute",
          "title": "Move traffic to an alternate path or load-balance",
          "risk": "medium",
          "needs_approval": true,
          "rollback": "Restore the original routing metrics",
          "change_capabilities": []
        },
        {
          "id": "add-capacity",
          "title": "Add capacity (LAG or faster uplink) in a planned change",
          "risk": "low",
          "needs_approval": true,
          "rollback": "Remove the added members",
          "change_capabilities": []
        }
      ],
      "verify": [
        {
          "metric": "link_utilization",
          "op": "<",
          "value": 70
        },
        {
          "metric": "link_latency_ms",
          "op": "<",
          "value": 30
        },
        {
          "metric": "link_packet_loss",
          "op": "<",
          "value": 1
        }
      ],
      "rootiq_kind": "link",
      "vendor_hints": {},
      "applies_to": [
        "link"
      ]
    },
    {
      "id": "crc-errors",
