          "capability": "show_interface_errors",
          "why": "Read CRC/FCS, runts, giants counters"
        },
        {
          "capability": "show_optics",
          "why": "Check optical power (DOM) if fiber"
        },
        {
          "capability": "show_interface_status",
          "why": "Verify negotiated speed/duplex"
        },
        {
          "capability": "show_logging",
          "why": "Correlate with flaps"
        }
      ],
      "fixes": [
        {
          "id": "clear-and-watch",
          "title": "Clear counters and watch whether errors grow again",
          "risk": "low",
          "needs_approval": true,
          "rollback": "Nothing to roll back",
          "change_capabilities": [
            "clear_counters"
          ]
        },
        {
          "id": "replace-media",
          "title": "Replace the cable or SFP, clean the fiber",
          "risk": "low",
          "needs_approval": true,
          "rollback": "Reinstall the original if no improvement",
          "change_capabilities": []
        }
      ],
      "verify": [
        {
          "metric": "link_packet_loss",
          "op": "<",
          "value": 1
        }
      ],
      "rootiq_kind": null,
      "vendor_hints": {
        "cisco": "Watch 'show interfaces <if> counters errors': FCS-Err, Align-Err, Runts, Giants."
      },
      "applies_to": [
        "link"
      ]
    },
    {
