POSTGRES_USER=rootiq
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=rootiq
DATABASE_URL=postgresql+psycopg://rootiq:replace-with-a-long-random-password@localhost:5432/rootiq
TOPOLOGY_STATE_PATH=../data/topology-observed.json
LAYOUT_PATH=../configs/layout.json
INGEST_TOKEN=replace-with-a-long-random-value
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
DISCOVERY_STALE_AFTER_S=180
LAB_AGENT_URL=http://127.0.0.1:9000
LAB_AGENT_TOKEN=replace-with-another-long-random-value
RECORD_EVENTS=0
# --- optional LLM wording layer (everything works without it) ---
LLM_ENABLED=0
LLM_PROVIDER=anthropic       # anthropic | gemini | groq | openrouter | custom
LLM_MODEL=                   # empty = provider default
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=          # https://openrouter.ai — never commit a real key
# provider=custom: your own fine-tuned model behind any OpenAI-compatible server
# (Ollama http://localhost:11434/v1, vLLM, a Hugging Face endpoint...)
LLM_BASE_URL=
CUSTOM_LLM_API_KEY=
# --- multi-agent layer ---
ROOTIQ_EXECUTION_ENABLED=0     # keep 0 until the live lab agent is configured and tested
# Demo-only fault controls: enable only on the isolated EVE-NG RootIQ lab.
DEMO_ENABLED=0
DEMO_LAB_ID=
AGENT_TIMEOUT_S=8
GUARDRAIL_MAX_EXECUTIONS=5     # per 5 minutes
RAG_MIN_SCORE=0.10
# KB_ROOT=                   # folder containing docs/ and lab/configs (auto-detected)
